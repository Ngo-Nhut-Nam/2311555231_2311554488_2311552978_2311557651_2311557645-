@model List<OrderListViewModel>
<table class="table">
    <thead><tr><th>Order ID</th><th>Customer Name</th><th>Order Date</th><th>Số loại sản phẩm</th></tr></thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.CustomerName</td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                <td>@o.DistinctProductCount</td>
            </tr>
        }
    </tbody>
</table>